{
  "manifest_version": 3,
  "name": "Pinterest Multi-User AI Agent",
  "version": "2.0",
  "description": "Syncs client Google Drive and Pinterest session to central Vercel AI Agent",
  "permissions": [
    "cookies",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://*.pinterest.com/*",
    "https://*.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
