{
  "manifest_version": 3,
  "name": "Pinterest Session Sync Agent",
  "version": "1.0",
  "description": "Extracts Pinterest session cookie for Cloud AI Automation Agent",
  "permissions": [
    "cookies",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.pinterest.com/*",
    "https://*.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
